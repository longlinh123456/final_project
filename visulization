// Visulization of gpa
gpa = df["5. What is your GPA for the last semester?"].iloc[:, 0]
sns.countplot(x=gpa, data = df)
plt.title("GPA Distribution")
plt.xlabel("GPA")
plt.ylabel("Count")
plt.show()

// Correlation between gpa and self-studying hours
study_hours = df['8. On average, how many hours do you spend self-studying a day?'].iloc[:, 0]
sns.boxplot(x=gpa,y=study_hours,data=df)
plt.title("Study Hours vs GPA")
plt.xlabel("GPA")
plt.ylabel("Study Hours")
plt.show()
